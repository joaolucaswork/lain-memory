# ── Server ───────────────────────────────────────────────────────────────
# Port for the memory HTTP server.
LAIN_MEMORY_PORT=3341
# Bearer auth. Empty = open localhost (same semantics as lain validateApiKey).
LAIN_API_KEY=

# ── Workspace ────────────────────────────────────────────────────────────
# Graph, seeds and PGS sessions live here (owned by this server).
# `~` is expanded. The directory is created by ./setup.sh (or manually).
LAIN_WORKSPACE_DIR=~/lain-memory-workspace
LAIN_PROJECTS_BASE=~/Documents/GitHub

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# LAIN_QDRANT_API_KEY=

# ── LLM (unified, model-agnostic — any OpenAI-compatible endpoint) ─────────
# LAIN_LLM_* wins, AI_GATEWAY_* fallback, then direct OpenAI. Mem0 internal LLM/embeddings also route via the gateway.
# LAIN_LLM_BASE_URL=https://openrouter.ai/api/v1
# LAIN_LLM_API_KEY=
# LAIN_LLM_MODEL=           # default: openai/gpt-4o-mini via gateway
# LAIN_EMBED_MODEL=         # default: openai/text-embedding-3-small via gateway
# LAIN_FAST_MODEL=deepseek/deepseek-v4-flash
# LAIN_STANDARD_MODEL=deepseek/deepseek-v4-flash
# LAIN_LLM_PROVIDER_ROUTING=  # unset = soft p90 latency preference (OpenRouter only); off disables

# ── Redis (optional — all memory paths degrade gracefully without it) ──────
LAIN_REDIS_ENABLED=true
LAIN_REDIS_HOST=127.0.0.1
LAIN_REDIS_PORT=6379
# LAIN_REDIS_PASSWORD=

# ── GraphRAG ───────────────────────────────────────────────────────────────
# LAIN_GRAPHRAG_ENABLED=false
# LAIN_GRAPHRAG_MAX_CONTEXT_NODES=10
# LAIN_GRAPHRAG_MAX_DEPTH=3
# LAIN_GRAPHRAG_SAVE_DEBOUNCE_MS=1000

# ── Instance / maintenance ─────────────────────────────────────────────────
# Suffixes the Qdrant collection (mem0[-ID]), the graph filename and the
# Redis key prefix. Instances sharing a workspace must use the same ID.
LAIN_INSTANCE_ID=
# LAIN_MIN_RECALL_SCORE=0.356
# LAIN_MEMORY_REAPER_ENABLED=
# LAIN_MEMORY_REAPER_DRY_RUN=false
# LAIN_MEMORY_REAPER_FETCH_LIMIT=200
# LAIN_REAPER_AUDIT_PATH=~/.lain/audit/memory-reaper.log.jsonl

# ── Seeds + PGS ──────────────────────────────────────────────────────────
# LAIN_SEED_ENABLED=true        # false disables extractSeed (default: enabled)
# LAIN_SEED_MAX_CHUNKS=10
# LAIN_SEED_MAX_FACTS=10
# LAIN_ENABLE_PGS=on
